{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "capSACIN Studio",
  "version": "0.1.2",
  "identifier": "edu.umn.sampel.capsacin-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "capSACIN Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../systemSetup/input/1dzl.pdb": "pdb/1dzl.pdb",
      "../../systemSetup/input/1k3v.pdb": "pdb/1k3v.pdb",
      "../../systemSetup/input/1wcd.pdb": "pdb/1wcd.pdb",
      "../../systemSetup/input/2buk.pdb": "pdb/2buk.pdb",
      "../../systemSetup/input/2ztn.pdb": "pdb/2ztn.pdb",
      "../../systemSetup/input/3r0r.pdb": "pdb/3r0r.pdb",
      "../../systemSetup/input/3ra2.pdb": "pdb/3ra2.pdb",
      "../../systemSetup/input/4oq8.pdb": "pdb/4oq8.pdb",
      "../../systemSetup/input/5cw0.pdb": "pdb/5cw0.pdb",
      "../../systemSetup/input/6jja.pdb": "pdb/6jja.pdb",
      "../../systemSetup/input/8des.pdb": "pdb/8des.pdb",
      "../../systemSetup/input/9clj.pdb": "pdb/9clj.pdb",
      "../../systemSetup/input/9jjh.pdb": "pdb/9jjh.pdb"
    },
    "externalBin": [
      "binaries/capsacin-sidecar"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "copyright": "SAMPEL Group \u2014 Internal Use Only",
    "category": "Medical"
  }
}
