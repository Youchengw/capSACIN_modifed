{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "capSACIN Studio",
  "version": "0.1.0",
  "identifier": "edu.umn.sampel.capsacin-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "capSACIN Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../systemSetup/input/*.pdb": "pdb/"
    },
    "externalBin": [
      "binaries/capsacin-sidecar"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "copyright": "SAMPEL Group — Internal Use Only",
    "category": "Medical"
  }
}
